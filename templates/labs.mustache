<div class="topomojo-directory topomojo-lab-list lab-list">
  <div class="topomojo-directory__header topomojo-directory__header--split">
    <div class="topomojo-directory__heading">
      <div class="topomojo-directory__brand">
        <span class="topomojo-directory__emoji">🎮</span>
      </div>
      <div>
        <div class="topomojo-directory__title">{{title}}</div>
        <div class="topomojo-directory__result-count lab-result-count"></div>
      </div>
    </div>

    <div class="topomojo-lab-list__search">
      <label class="topomojo-lab-list__search-label">
        <input type="search" class="lab-search topomojo-lab-list__search-input"
               placeholder="Search labs, courses, tags…"
               aria-label="Search labs">
        <span class="topomojo-lab-list__search-icon">🔎</span>
        <button type="button" class="lab-clear topomojo-lab-list__clear"
                aria-label="Clear search"
                title="Clear">✕</button>
      </label>
    </div>
  </div>

  <div class="topomojo-directory__body">
    {{#hascards}}
      <div class="topomojo-lab-list__grid lab-grid">
        {{#cards}}
          <div class="topomojo-lab-card lab-card"
               data-name="{{name}}"
               data-course="{{coursename}}"
               data-tags="{{#tags}}{{name}} {{/tags}}"
               data-competencies="{{#competencies}}{{name}} {{/competencies}}">
            <div class="topomojo-lab-card__icon">
              <img src="{{iconurl}}" alt="">
            </div>

            <div class="topomojo-lab-card__content">
              <div class="topomojo-lab-card__title">
                <a href="{{url}}" class="lab-title">{{name}}</a>
              </div>

              <div class="topomojo-lab-card__course-wrap">
                <a href="{{courseurl}}" class="topomojo-lab-card__course lab-course">
                  <span>🎓</span>
                  <span>{{coursename}}</span>
                </a>
              </div>

              {{#hastags}}
                <div class="topomojo-lab-card__tags lab-tags">
                  {{#tags}}
                    <span class="topomojo-lab-card__tag">📌 {{name}}</span>
                  {{/tags}}
                </div>
              {{/hastags}}

              {{#hascompetencies}}
                <div class="topomojo-lab-card__competencies lab-competencies">
                  {{#competencies}}
                    <span class="topomojo-lab-card__competency">🎯 {{name}}</span>
                  {{/competencies}}
                </div>
              {{/hascompetencies}}

              <div class="topomojo-lab-card__action">
                <a href="{{url}}">▶ View Lab</a>
              </div>
            </div>
          </div>
        {{/cards}}
      </div>

      <div class="topomojo-directory__empty lab-empty">No labs match your search.</div>
    {{/hascards}}

    {{^hascards}}
      <div class="topomojo-directory__empty">{{#str}} noactivitiesmapped, mod_topomojo {{/str}}</div>
    {{/hascards}}
  </div>
</div>

{{#js}}
require(['mod_topomojo/search'], function(search) {
  search.init('.lab-list');
});
{{/js}}
