<div class="topomojo-directory topomojo-labofday">
  <div class="topomojo-directory__header">
    <div class="topomojo-directory__brand">
      <span class="topomojo-directory__emoji">🎮</span>
    </div>
    <div class="topomojo-directory__heading">
      <div class="topomojo-directory__title">{{title}}</div>
    </div>
  </div>

  <div class="topomojo-directory__body">
    {{#hascards}}
      <div class="topomojo-directory__grid">
        {{#cards}}
          <div class="topomojo-lab-card">
            <div class="topomojo-lab-card__icon">
              <img src="{{iconurl}}" alt="">
            </div>

            <div class="topomojo-lab-card__content">
              <div class="topomojo-lab-card__title">
                <a href="{{url}}">{{name}}</a>
              </div>

              <div class="topomojo-lab-card__course-wrap">
                <a href="{{courseurl}}" class="topomojo-lab-card__course">
                  <span>🎓</span>
                  <span>{{coursename}}</span>
                </a>
              </div>

              {{#hastags}}
                <div class="topomojo-lab-card__tags">
                  {{#tags}}
                    <span class="topomojo-lab-card__tag">📌 {{name}}</span>
                  {{/tags}}
                </div>
              {{/hastags}}

              {{#hascompetencies}}
                <div class="topomojo-lab-card__competencies">
                  {{#competencies}}
                    <span class="topomojo-lab-card__competency">🎯 {{name}}</span>
                  {{/competencies}}
                </div>
              {{/hascompetencies}}

              <div class="topomojo-lab-card__action">
                <a href="{{url}}">▶ View Lab</a>
              </div>
            </div>
          </div>
        {{/cards}}
      </div>
    {{/hascards}}

    {{^hascards}}
      <div class="topomojo-directory__empty">{{#str}} noactivitiesmapped, mod_topomojo {{/str}}</div>
    {{/hascards}}
  </div>
</div>
